    "eval_df = pd.DataFrame({'actual': y_test, 'predicted': test_prob})\n",
    "eval_df['risk_decile'] = pd.qcut(eval_df['predicted'].rank(method='first'), q=10, labels=False) + 1\n",
    "calibration = (eval_df.groupby('risk_decile')\n",
    "               .agg(n=('actual', 'size'), average_predicted_risk=('predicted', 'mean'),\n",
    "                    observed_hospitalization_rate=('actual', 'mean')))\n",
    "display(calibration.round(4))\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4))\n",
    "fpr, tpr, _ = roc_curve(y_test, test_prob)\n",
    "axes[0].plot(fpr, tpr, label=f'ROC-AUC = {metrics[\"roc_auc\"]:.3f}')\n",
    "axes[0].plot([0, 1], [0, 1], linestyle=':', color='gray')\n",
    "axes[0].set(xlabel='False positive rate', ylabel='True positive rate', title='Held-out ROC curve')\n",
    "axes[0].legend()\n",
    "precision, recall, _ = precision_recall_curve(y_test, test_prob)\n",
    "axes[1].plot(recall, precision, label=f'PR-AUC = {metrics[\"pr_auc\"]:.3f}')\n",
    "axes[1].axhline(prevalence, linestyle=':', color='gray', label='Population prevalence')\n",
    "axes[1].set(xlabel='Recall', ylabel='Precision', title='Held-out precision-recall curve')\n",
    "axes[1].legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.plot(calibration['average_predicted_risk'], calibration['observed_hospitalization_rate'], marker='o', label='Test deciles')\n",
    "plt.plot([0, 1], [0, 1], linestyle=':', color='gray', label='Perfect calibration')\n",
    "plt.xlabel('Mean estimated risk')\n",
    "plt.ylabel('Observed hospitalization frequency')\n",
    "plt.title('Calibration across predicted-risk deciles')\n",
    "plt.xlim(0, max(0.3, calibration['average_predicted_risk'].max() * 1.1))\n",
    "plt.ylim(0, max(0.3, calibration['observed_hospitalization_rate'].max() * 1.1))\n",
    "plt.legend()\n",
