    "selected = make_pipeline(CANDIDATES[chosen_name]())\n",
    "selected.fit(X.iloc[train_dev_idx], y.iloc[train_dev_idx])\n",
    "y_test = y.iloc[test_idx].to_numpy()\n",
    "test_prob = selected.predict_proba(X.iloc[test_idx])[:, 1]\n",
    "assert np.isfinite(test_prob).all() and np.all((test_prob >= 0) & (test_prob <= 1))\n",
    "\n",
    "n_top = int(np.ceil(0.10 * len(y_test)))\n",
    "top_idx = np.argsort(-test_prob, kind='stable')[:n_top]\n",
    "prevalence = float(np.mean(y_test))\n",
    "precision_top = float(y_test[top_idx].mean())\n",
    "recall_top = float(y_test[top_idx].sum() / y_test.sum())\n",
    "metrics = {\n",
    "    'roc_auc': float(roc_auc_score(y_test, test_prob)),\n",
    "    'pr_auc': float(average_precision_score(y_test, test_prob)),\n",
    "    'brier': float(brier_score_loss(y_test, test_prob)),\n",
    "    'prevalence': prevalence,\n",
    "    'top10_precision': precision_top,\n",
    "    'top10_recall': recall_top,\n",
    "    'top10_lift': precision_top / prevalence,\n",
    "}\n",
    "print('Held-out test results')\n",
    "for name, value in metrics.items():\n",
    "    print(f'  {name:20} {value:.4f}')\n",
    "print(f'Among the highest-risk 10% ({n_top:,} of {len(y_test):,} people): '\n",
    "      f'{y_test[top_idx].sum():,} were hospitalized.')"
   ]
