   "source": [
    "def make_pipeline(model):\n",
    "    numerical = Pipeline([\n",
    "        ('impute', SimpleImputer(strategy='median', add_indicator=True)),\n",
    "        ('scale', StandardScaler()),\n",
    "    ])\n",
    "    preprocessing = ColumnTransformer([\n",
    "        ('numeric', numerical, NUMERIC),\n",
    "        ('categorical', OneHotEncoder(handle_unknown='ignore', sparse_output=False), CATEGORICAL),\n",
    "    ], sparse_threshold=0)\n",
    "    return Pipeline([('preprocess', preprocessing), ('model', model)])\n",
    "\n",
    "CANDIDATES = {\n",
    "    'Logistic regression': lambda: LogisticRegression(max_iter=500, random_state=SEED),\n",
    "    'Hist gradient boosting': lambda: HistGradientBoostingClassifier(random_state=SEED),\n",
    "}\n",
    "\n",
    "results = []\n",
    "for name, factory in CANDIDATES.items():\n",
    "    candidate = make_pipeline(factory())\n",
    "    candidate.fit(X.iloc[train_idx], y.iloc[train_idx])\n",
    "    dev_prob = candidate.predict_proba(X.iloc[dev_idx])[:, 1]\n",
    "    results.append({'model': name,\n",
    "                    'dev_roc_auc': roc_auc_score(y.iloc[dev_idx], dev_prob),\n",
    "                    'dev_pr_auc': average_precision_score(y.iloc[dev_idx], dev_prob),\n",
    "                    'dev_brier': brier_score_loss(y.iloc[dev_idx], dev_prob)})\n",
    "comparison = pd.DataFrame(results).sort_values('dev_roc_auc', ascending=False).reset_index(drop=True)\n",
    "display(comparison.round(4))\n",
    "chosen_name = comparison.loc[0, 'model']\n",
    "print('Selected using development ROC-AUC:', chosen_name)"
   ]
  },
